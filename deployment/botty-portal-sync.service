[Unit]
Description=Publish Portal+ main with verified Botty+ and Codex PS5 main packages
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=botty-portal
Group=botty-portal
EnvironmentFile=-/etc/botty-portal-sync.env
ExecStart=/usr/bin/python3 /opt/botty-portal/sync-portal-main.py
StateDirectory=botty-portal
StateDirectoryMode=0700
TimeoutStartSec=20min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/botty-ps5
