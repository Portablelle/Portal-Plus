ARG PLUS_RUNNER_IMAGE=plus-runner:latest
FROM ${PLUS_RUNNER_IMAGE} AS runner
FROM rust:1.95.0-slim-trixie AS rust
FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates clang-18 clang-19 clang-format-19 lld-18 lld-19 llvm-18 llvm-19 \
    make cmake ninja-build curl wget unzip xz-utils python3 python3-pil python3-jsonschema python3-jinja2 \
    pkg-config autoconf automake libtool perl git file jq openssh-client \
    libssl-dev libclang-19-dev libcurl4-openssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=runner /opt/actions-runner /opt/actions-runner
COPY --from=runner /opt/hostedtoolcache /opt/hostedtoolcache
RUN /opt/actions-runner/bin/installdependencies.sh && rm -rf /var/lib/apt/lists/* \
    && node_dir="$(find /opt/hostedtoolcache/node -mindepth 2 -maxdepth 2 -type d -name x64)" \
    && test -x "$node_dir/bin/node" && cp -a "$node_dir"/. /usr/local/
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:/usr/lib/llvm-19/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk LLVM_CONFIG=/usr/bin/llvm-config-19
ENV SDK_BUILD_JOBS=2 BUILD_JOBS=2 CARGO_BUILD_JOBS=2
COPY sources.lock.json bootstrap-sdk.sh prepare-rust-std.py /tmp/codex-toolchain/
RUN bash /tmp/codex-toolchain/bootstrap-sdk.sh /tmp/codex-toolchain/sources.lock.json \
    && rustup component add rust-src && rustup target add x86_64-unknown-freebsd \
    && python3 /tmp/codex-toolchain/prepare-rust-std.py \
    && rm -rf /tmp/codex-toolchain
RUN apt-get update && apt-get install -y --no-install-recommends gh build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1001 runner \
    && chown -R runner:runner /opt/actions-runner /opt/hostedtoolcache \
    && git config --system init.defaultBranch main
ENV CARGO_HOME=/home/runner/.cargo
ENV AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache RUNNER_TOOL_CACHE=/opt/hostedtoolcache
USER runner
WORKDIR /home/runner
CMD ["bash"]
