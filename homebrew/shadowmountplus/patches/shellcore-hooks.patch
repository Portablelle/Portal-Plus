+// Physical writes do not make clean executable pages private/dirty. If the
+// pager reclaims one, the original file bytes replace our patch. Keep all hook
+// and bridge pages resident before writing; retain locks for ShellCore's life
+// because in-flight calls can still return through a bridge after shutdown.
+static bool lock_hook_pages(pid_t pid, const sm_shellcore_remote_t *remote,
+                            size_t hook_count, uintptr_t bridge, size_t blob_size) {
+  const uintptr_t page_mask = 0x3fffu;
+  uintptr_t pages[8];
+  size_t count = 0;
+  if (!sm_kstuff_is_loaded() || hook_count > SHELLCORE_MAX_HOOK_COUNT)
+    return false;
+  for (size_t i = 0; i <= hook_count; ++i) {
+    sm_shellcore_target_t target = i == 0 ? SM_SHELLCORE_TARGET_LAUNCH_APP :
+        i == 1 ? SM_SHELLCORE_TARGET_SANDBOX_READY : SM_SHELLCORE_TARGET_INSTALL_ALL;
+    uintptr_t address = i == hook_count ? bridge : remote->targets[target];
+    size_t size = i == hook_count ? blob_size : remote->offsets->targets[target].patch_size;
+    if (!size || address > UINTPTR_MAX - (size - 1u))
+      return false;
+    uintptr_t first = address & ~page_mask;
+    uintptr_t last = (address + size - 1u) & ~page_mask;
+    for (uintptr_t page = first;; page += page_mask + 1u) {
+      size_t j = 0;
+      while (j < count && pages[j] != page) ++j;
+      if (j == count) {
+        if (count == sizeof(pages) / sizeof(pages[0]) ||
+            !sm_kstuff_remote_mlock(pid, page, page_mask + 1u)) {
+          log_debug("  [SHELLCORE] cannot pin hook page 0x%lx; installation refused",
+                    (unsigned long)page);
+          return false;
+        }
+        pages[count++] = page;
+      }
+      if (page == last) break;
+    }
+  }
+  log_debug("  [SHELLCORE] pinned %zu hook/bridge pages", count);
+  return true;
+}
